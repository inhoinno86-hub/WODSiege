{
  "name": "wodsiege",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "server": "node server/index.mjs",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --test tests/*.test.mjs",
    "test:e2e": "playwright test",
    "android:sync": "npm run build && cap sync android",
    "android:build": "npm run android:sync && bash scripts/build-android.sh",
    "android:preflight": "node scripts/android-preflight.mjs",
    "data:backup": "node scripts/data-backup.mjs backup",
    "data:verify": "node scripts/data-backup.mjs verify",
    "data:restore": "node scripts/data-backup.mjs restore",
    "operator:rotate": "node scripts/operator-password.mjs"
  },
  "dependencies": {
    "@capacitor/android": "8.5.1",
    "@capacitor/core": "8.5.1",
    "@capacitor/geolocation": "^8.0.0",
    "@fontsource-variable/noto-sans-kr": "^5.3.0",
    "@fontsource/barlow-condensed": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "express": "5.2.1",
    "lucide-react": "^0.577.0",
    "multer": "2.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.1",
    "@playwright/test": "1.63.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.4.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.0",
    "vite": "^6.4.3"
  }
}
